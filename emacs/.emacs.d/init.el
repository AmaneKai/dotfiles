;;; init.el -*- lexical-binding: t; -*-
;; Adapted from https://github.com/rexim/dotfiles

(setq custom-file (locate-user-emacs-file "custom.el"))
(package-initialize)

(add-to-list 'load-path (locate-user-emacs-file "local"))

(load (locate-user-emacs-file "rc/rc.el"))
(load (locate-user-emacs-file "rc/misc-rc.el"))
(load (locate-user-emacs-file "rc/org-mode-rc.el"))

;; Load saved Customize settings early so they apply to everything below.
(load custom-file t)

;;; Appearance
;; Same font and size as wezterm.  Set through default-frame-alist so it also
;; reaches graphical frames opened by the daemon; terminal frames ignore it.
(add-to-list 'default-frame-alist '(font . "JetBrainsMono Nerd Font-16"))

(setq inhibit-startup-screen t)

(when (fboundp 'tool-bar-mode) (tool-bar-mode -1))
(when (fboundp 'menu-bar-mode) (menu-bar-mode -1))
(when (fboundp 'scroll-bar-mode) (scroll-bar-mode -1))
(column-number-mode 1)
(show-paren-mode 1)

(rc/require-theme 'gruber-darker)
