font-size = 12
theme = Rose Pine
foreground = #ffffff
background = #121212
background-opacity = 0.95
background-blur = 8
window-padding-x = 10
window-padding-y = 10
cursor-style = block

keybind = ctrl+Equal=increase_font_size:1
keybind = ctrl+Minus=decrease_font_size:1
keybind = ctrl+Digit0=reset_font_size
