#!/bin/bash

readonly PICTURES_DIR="$HOME/Pictures"

move_top_level_files() {
    local destination=$1
    shift
    mkdir -p "$PICTURES_DIR/$destination"
    find "$PICTURES_DIR" -maxdepth 1 -type f "$@" -exec mv {} "$PICTURES_DIR/$destination/" \;
}

move_top_level_files Screenshots \( -name 'Screenshot*.png' -o -name 'screenshot-*.png' \)
move_top_level_files Recordings -name 'Screen Recording*.mov'
move_top_level_files other
