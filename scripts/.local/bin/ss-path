#!/usr/bin/env bash
# Region screenshot -> file, with the file's path left in the clipboard as text.
# Pasting the path into Claude Code attaches the image (image paste from the
# clipboard is unreliable).
dir="$HOME/Pictures/Screenshots"
mkdir -p "$dir"
file="$dir/ss-$(date +%Y%m%d-%H%M%S).png"

spectacle -b -n -r -o "$file" || exit 1
[[ -s $file ]] || exit 1

printf '%s' "$file" | wl-copy
notify-send -t 1500 "Screenshot saved" "$file"
