[global]
    font                 = JetBrainsMono Nerd Font 10
    markup               = full
    format               = "<b>%s</b>\n<span alpha='80%%'>%b</span>"

    corner_radius        = 0
    icon_corner_radius   = 0
    gap_size             = 8
    frame_width          = 1
    frame_color          = "#26233a"

    progress_bar                 = true
    progress_bar_height          = 6
    progress_bar_frame_width     = 0
    progress_bar_corner_radius   = 0
    progress_bar_min_width       = 240
    progress_bar_max_width       = 320

    origin               = top-right
    offset               = 20x20
    width                = (0, 360)
    height               = (0, 200)
    padding              = 14
    horizontal_padding   = 18
    text_icon_padding    = 12

    min_icon_size        = 32
    max_icon_size        = 32
    icon_path            = /usr/share/icons/Papirus-Dark/32x32/

    sort                 = yes
    indicate_hidden      = yes
    show_age_threshold   = 60
    word_wrap            = yes
    ignore_newline       = no
    sticky_history       = yes
    history_length       = 20
    show_indicators      = no
    follow               = keyboard

[urgency_low]
    background           = "#1f1d2e"
    foreground           = "#e0def4"
    highlight            = "#9ccfd8"
    format               = "<span foreground='#9ccfd8'>●</span>  <b>%s</b>\n<span alpha='75%%'>%b</span>"
    timeout              = 4

[urgency_normal]
    background           = "#1f1d2e"
    foreground           = "#e0def4"
    format               = "<span foreground='#c4a7e7'>●</span>  <b>%s</b>\n<span alpha='75%%'>%b</span>"
    timeout              = 6

[urgency_critical]
    background           = "#26233a"
    foreground           = "#e0def4"
    format               = "<span foreground='#eb6f92'>●</span>  <b>%s</b>\n<span alpha='75%%'>%b</span>"
    timeout              = 0

[osd]
    appname              = osd
    format               = "%s"
    timeout              = 2

[shortcuts]
    close                = ctrl+space
    close_all            = ctrl+shift+space
    history              = ctrl+grave
    context              = ctrl+shift+period
