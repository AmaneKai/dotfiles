# Cream page, navy text. recolor maps white to the light colour and black to
# the dark colour, so pages render as cream paper with navy ink.
set font "Shippori Mincho 11"

set recolor true
set recolor-lightcolor "#f6e7c0"
set recolor-darkcolor  "#0a1626"
set recolor-keephue    false

set default-bg "#0a1626"
set default-fg "#f6e7c0"

set statusbar-bg "#070f1c"
set statusbar-fg "#f6e7c0"
set inputbar-bg  "#070f1c"
set inputbar-fg  "#f6e7c0"

set notification-bg         "#070f1c"
set notification-fg         "#f6e7c0"
set notification-error-bg   "#a65651"
set notification-error-fg   "#f6e7c0"
set notification-warning-bg "#dfba88"
set notification-warning-fg "#0a1626"

set completion-bg           "#070f1c"
set completion-fg           "#8e7f6b"
set completion-highlight-bg "#283a51"
set completion-highlight-fg "#f6e7c0"
set completion-group-bg     "#070f1c"
set completion-group-fg     "#ce8563"

set highlight-color        "rgba(206,133,99,0.45)"
set highlight-active-color "rgba(223,186,136,0.6)"

set index-bg        "#0a1626"
set index-fg        "#f6e7c0"
set index-active-bg "#283a51"
set index-active-fg "#f6e7c0"

set selection-clipboard clipboard
