# macOS-proportioned banners in the library palette. bg {{bg}}  text {{text}}
# muted {{muted}}  rule {{text:css:.16}}  accent {{accent}}. Alpha colours are #RRGGBBAA.
font=Noto Sans 9
background-color={{bg:hash:d9}}
text-color={{text}}
border-color={{text:hash:29}}
border-size=1
border-radius=0
progress-color=over {{text:hash:1f}}

# bold title over a lighter body, like a macOS banner
format=<b>%s</b>\n<span foreground='{{muted}}'>%b</span>

anchor=top-right
layer=overlay
width=290
height=100
padding=8,10
margin=4
outer-margin=8,12
default-timeout=6000

icons=1
icon-path=/usr/share/icons/breeze-dark:/usr/share/icons/breeze:/usr/share/icons/Adwaita:/usr/share/icons/hicolor:/usr/share/pixmaps
max-icon-size=26
icon-border-radius=0
icon-location=left

[urgency=low]
border-color={{surface}}
default-timeout=4000

[urgency=critical]
border-color={{accent}}
default-timeout=0

# volume / brightness (scripts/osd.sh): a small capsule, icon plus a level fill, no
# text, like the macOS HUD. The terracotta fill is the level.
[app-name=osd]
anchor=bottom-center
width=150
height=30
padding=6,12
outer-margin=0,0,72,0
border-radius=0
format=
icon-location=left
max-icon-size=16
icon-border-radius=0
progress-color=over {{accent:hash:b3}}
default-timeout=1300
