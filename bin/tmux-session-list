#!/usr/bin/env bash
# picker source: project folders scanned live, then running tmux sessions and sesh.toml projects.
# scanning live is what makes freshly cloned repos show up right away.

SEARCH_PATHS=(
    "${DOTFILES:-$HOME/Dotfiles}"
    "$HOME/Github"
    "$HOME/Codes"
    "$HOME/College"
    "$HOME/Downloads"
    "$HOME/LBYARCH"
)

mode=${1:-all}

list_dirs() {
    for dir in "${SEARCH_PATHS[@]}"; do
        [[ -d $dir ]] || continue
        echo "$dir"
        find "$dir" -mindepth 1 -maxdepth 1 -type d -not -name '.*'
    done | sed "s|^$HOME|~|" | sed 's/^/ /'
}

case $mode in
    all)
        # dirs first, then sesh; drop sesh rows whose path was already listed
        {
            list_dirs
            sesh list --icons -t -c
        } | awk '{ key=$0; sub(/^[^~\/[:alnum:]]+ */, "", key); if (!seen[key]++) print }'
        ;;
    *) sesh list --icons "$@" ;;
esac
