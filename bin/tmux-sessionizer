#!/usr/bin/env bash

SEARCH_PATHS=(
    "${DOTFILES:-$HOME/Dotfiles}"
    "$HOME/Github"
    "$HOME/Codes"
    "$HOME/College"
    "$HOME/Downloads"
    "$HOME/Pictures/Recordings/"
    "$HOME/Pictures/Screenshots/"
    "$HOME/LBYARCH"
)

list_potential_sessions() {
    for dir in "${SEARCH_PATHS[@]}"; do
        if [[ -d "$dir" ]]; then
            echo "$dir"
            find "$dir" -mindepth 1 -maxdepth 1 -type d
        fi
    done
}

get_session_name() {
    local path=$1
    basename "$path" | tr . _ | tr : _
}

switch_to_session() {
    local name=$1
    local path=$2

    if ! tmux has-session -t="$name" 2>/dev/null; then
        tmux new-session -ds "$name" -c "$path"
    fi

    if [[ -z $TMUX ]]; then
        tmux attach-session -t "$name"
    else
        tmux switch-client -t "$name"
    fi
}

# project folders + running sessions + sesh.toml projects in one picker
pick_with_sesh() {
    local selected
    selected=$("$(dirname "$0")/tmux-session-list" | fzf --reverse --ansi --no-sort \
        --prompt='  ' --header='^a all  ^t tmux  ^g config  ^f dirs' \
        --bind 'ctrl-a:change-prompt(  )+reload('"$(dirname "$0")"'/tmux-session-list)' \
        --bind 'ctrl-t:change-prompt(  )+reload(sesh list --icons -t)' \
        --bind 'ctrl-g:change-prompt(  )+reload(sesh list --icons -c)' \
        --bind 'ctrl-f:change-prompt(  )+reload(fd -H -d 2 -t d -E .Trash . ~)')
    [[ -z $selected ]] && return
    # drop the icon prefix and expand ~ so sesh gets a plain name or path
    selected=$(printf '%s' "$selected" | sed -E "s/^[^~\/[:alnum:]]+ *//; s|^~|$HOME|")
    sesh connect "$selected"
}

main() {
    local selected

    if [[ $# -eq 0 ]] && command -v sesh >/dev/null 2>&1; then
        pick_with_sesh
        return
    fi

    if [[ $# -eq 1 ]]; then
        selected=$1
    else
        selected=$(list_potential_sessions | fzf --reverse --prompt='session > ')
    fi

    if [[ -z "$selected" ]]; then
        exit 0
    fi

    local session_name
    session_name=$(get_session_name "$selected")

    switch_to_session "$session_name" "$selected"
}

main "$@"
