#!/usr/bin/env bash

SEARCH_PATHS=(
    "${DOTFILES:-$HOME/Dotfiles}"
    "$HOME/Github"
    "$HOME/Codes"
    "$HOME/College"
    "$HOME/Downloads"
    "$HOME/Pictures/Recordings/"
    "$HOME/Pictures/Screenshots/"
)

list_potential_sessions() {
    for dir in "${SEARCH_PATHS[@]}"; do
        if [[ -d "$dir" ]]; then
            echo "$dir"
            find "$dir" -mindepth 1 -maxdepth 1 -type d
        fi
    done
}

get_session_name() {
    local path=$1
    basename "$path" | tr . _ | tr : _
}

switch_to_session() {
    local name=$1
    local path=$2

    if ! tmux has-session -t="$name" 2>/dev/null; then
        tmux new-session -ds "$name" -c "$path"
    fi

    if [[ -z $TMUX ]]; then
        tmux attach-session -t "$name"
    else
        tmux switch-client -t "$name"
    fi
}

main() {
    local selected

    if [[ $# -eq 1 ]]; then
        selected=$1
    else
        selected=$(list_potential_sessions | fzf)
    fi

    if [[ -z "$selected" ]]; then
        exit 0
    fi

    local session_name
    session_name=$(get_session_name "$selected")

    switch_to_session "$session_name" "$selected"
}

main "$@"
