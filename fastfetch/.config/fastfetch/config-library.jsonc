// Library rice. Not loaded by default; run with:
//   fastfetch -c ~/.config/fastfetch/config-library.jsonc
// Colours are truecolor SGR codes: terracotta 206;133;99  accent2 166;86;81
// highlight 223;186;136  soft green 200;205;171  text 246;231;192  muted 142;127;107
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/logo/library.txt",
        "padding": {
            "top": 1,
            "left": 2,
            "right": 3
        },
        "color": {
            "1": "38;2;142;127;107",
            "2": "38;2;206;133;99",
            "3": "38;2;166;86;81",
            "4": "38;2;223;186;136",
            "5": "38;2;200;205;171"
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "38;2;206;133;99",
            "output": "38;2;246;231;192"
        }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "color": {
                "user": "38;2;246;231;192",
                "at": "38;2;142;127;107",
                "host": "38;2;223;186;136"
            }
        },
        {
            "type": "custom",
            "format": "────────────────────────",
            "outputColor": "38;2;58;77;104"
        },
        {
            "type": "os",
            "key": "󰣇 "
        },
        {
            "type": "host",
            "key": "󰌢 "
        },
        {
            "type": "shell",
            "key": " "
        },
        {
            "type": "terminal",
            "key": " "
        },
        {
            "type": "wm",
            "key": " "
        },
        {
            "type": "display",
            "key": "󰍹 "
        },
        {
            "type": "cpu",
            "key": "󰻠 "
        },
        {
            "type": "gpu",
            "key": "󰢮 "
        },
        {
            "type": "memory",
            "key": "󰍛 "
        },
        {
            "type": "swap",
            "key": "󰾴 "
        },
        {
            "type": "disk",
            "key": "󰋊 "
        },
        {
            "type": "battery",
            "key": "󰁹 "
        },
        "break",
        {
            "type": "colors",
            "symbol": "block"
        }
    ]
}
