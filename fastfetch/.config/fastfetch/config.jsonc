{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/logo/yorushika.txt",
        "padding": {
            "top": 2,
            "left": 3
        },
        "color": {
            "1": "white",
            "2": "cyan",
            "3": "magenta",
            "4": "white",
            "5": "blue"
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "cyan"
        }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "color": {
                "user": "white",
                "at": "cyan",
                "host": "white"
            }
        },
        "break",
        {
            "type": "os",
            "key": "󰣇 ",
            "keyColor": "cyan"
        },
        {
            "type": "host",
            "key": "󰌢 ",
            "keyColor": "cyan"
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "cyan"
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "cyan"
        },
        {
            "type": "de",
            "key": " ",
            "keyColor": "cyan"
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "cyan"
        },
        {
            "type": "display",
            "key": "󰍹 ",
            "keyColor": "cyan"
        },
        {
            "type": "cpu",
            "key": "󰻠 ",
            "keyColor": "cyan"
        },
        {
            "type": "gpu",
            "key": "󰢮 ",
            "keyColor": "cyan"
        },
        {
            "type": "memory",
            "key": "󰍛 ",
            "keyColor": "cyan"
        },
        {
            "type": "swap",
            "key": "󰾴 ",
            "keyColor": "cyan"
        },
        {
            "type": "disk",
            "key": "󰋊 ",
            "keyColor": "cyan"
        },
        {
            "type": "battery",
            "key": "󰁹 ",
            "keyColor": "cyan"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
